{
  "name": "D-blog | 跑路的duck",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "gen:data": "node scripts/generate-site-data.mjs",
    "migrate:images": "node scripts/migrate-images-picgo.mjs posts",
    "build:ssr": "vite build --config vite.ssr.config.ts",
    "ssg": "node scripts/ssg.mjs",
    "audit:build": "node scripts/audit-build.mjs",
    "audit:seo": "node scripts/seo-audit.mjs",
    "typecheck": "tsc -p config/tsconfig.json --noEmit",
    "check": "npm run gen:data && npm run typecheck",
    "dev": "npm run gen:data && vite",
    "build": "node scripts/build.mjs",
    "build:verbose": "node scripts/build.mjs --verbose",
    "preview": "vite preview",
    "test": "npm run gen:data && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run gen:data && vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "dompurify": "^3.4.5",
    "framer-motion": "^12.29.0",
    "highlight.js": "^11.9.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.38",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.13.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.18",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.4.35",
    "prettier": "^3.9.6",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.67.0",
    "unified": "^11.0.5",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": "eslint --fix",
    "*.{ts,tsx,js,mjs,json,md,css}": "prettier --write"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
