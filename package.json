{
  "name": "D-blog | 跑路的duck",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "gen:images": "node scripts/generate-image-assets.mjs",
    "gen:data": "npm run gen:images && node scripts/generate-site-data.mjs",
    "prerender": "node scripts/prerender.mjs",
    "typecheck": "tsc -p config/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run gen:data",
    "dev": "npm run gen:data && vite",
    "build": "npm run gen:data && vite build && npm run prerender",
    "preview": "vite preview"
  },
  "dependencies": {
    "dompurify": "^3.4.5",
    "framer-motion": "^12.29.0",
    "highlight.js": "^11.9.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.38",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.13.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.18",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "postcss": "^8.4.35",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.2",
    "unified": "^11.0.5",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  }
}
