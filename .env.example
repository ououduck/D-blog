# 站点公开访问地址，用于生成 sitemap、RSS 与预渲染 SEO URL。
# 留空时使用 config/site.config.json 中的 url。
VITE_SITE_URL=https://blog.pldduck.com

# 部署在子路径时填写，例如 GitHub Pages 的 /repo/；根路径部署请留空。
VITE_BASE_PATH=

# ---------- 以下为可选的构建/自动化调优变量（GitHub Actions 或本地） ----------
# 数值型变量支持显式 0（如 =0 表示禁用超时/跳过冷却/不重试），
# 不会静默回退默认值（parseEnvNumber 语义，见 scripts/lib/env.mjs）。

# build.mjs：单阶段超时（毫秒），默认 1200000（20 分钟）；0 立即触发超时（测试超时路径）。
# BUILD_STAGE_TIMEOUT_MS=1200000

# build.mjs：整条流水线总预算（毫秒），默认 3300000（55 分钟）。
# BUILD_TOTAL_TIMEOUT_MS=3300000

# ssg.mjs：SSG 全站渲染总预算（毫秒），默认 600000（10 分钟）。
# SSG_TOTAL_BUDGET_MS=600000

# friend-link-bot.mjs：申请审核冷却时长（毫秒），默认 600000（10 分钟）；0 跳过冷却。
# FRIEND_LINK_WAIT_MS=600000

# friend-link-bot.mjs：git push 目标分支，默认取 GITHUB_REF_NAME（main）。
# FRIEND_LINK_TARGET_BRANCH=main

# friend-link-check.mjs：单次请求超时（毫秒，默认 20000）/ 重试次数（默认 2，0 不重试）/ 并发数（默认 4）。
# FRIEND_LINK_CHECK_TIMEOUT_MS=20000
# FRIEND_LINK_CHECK_RETRIES=2
# FRIEND_LINK_CHECK_CONCURRENCY=4

# gh-actions-logger.mjs：debug 级别日志开关（Actions 中亦可设 ACTIONS_STEP_DEBUG=true）。
# DEBUG=1
# telegram-notify.mjs：GitHub 事件 → Telegram 推送（见 .github/workflows/telegram-notify.yml）。
# 推送内容：新评论/新讨论/新 Issue、push 提交、Action 运行结果；
# 未配置 token / chat id 时脚本优雅跳过（::warning:: 正常退出），不红叉。
# Actions 环境读取仓库 Secrets（Settings → Secrets and variables → Actions），不读取本地 .env；
# 以下变量仅用于本地 --print 调试或自建环境：
#   GITHUB_EVENT_NAME=push GITHUB_EVENT_PATH=event.json node scripts/telegram-notify.mjs --print
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...   # BotFather 创建机器人获取的 token
# TELEGRAM_CHAT_ID=123456789            # 接收通知的 chat id（私聊/群组/频道）
# TELEGRAM_TOPIC_ID=                    # 可选：论坛话题 id，设置后消息发往该话题
