# 站点公开访问地址，用于生成 sitemap、RSS 与预渲染 SEO URL。
# 留空时使用 config/site.config.ts 中的 url。
VITE_SITE_URL=https://blog.pldduck.com

# 部署在子路径时填写，例如 GitHub Pages 的 /repo/；根路径部署请留空。
VITE_BASE_PATH=

# ---------- 以下为可选的构建/自动化调优变量（GitHub Actions 或本地） ----------

# build.mjs：单阶段超时（毫秒），默认 1200000（20 分钟）。
# BUILD_STAGE_TIMEOUT_MS=1200000

# build.mjs：整条流水线总预算（毫秒），默认 3300000（55 分钟）。
# BUILD_TOTAL_TIMEOUT_MS=3300000

# ssg.mjs：SSG 全站渲染总预算（毫秒），默认 600000（10 分钟）。
# SSG_TOTAL_BUDGET_MS=600000

# friend-link-bot.mjs：申请审核冷却时长（毫秒），默认 600000（10 分钟）。
# FRIEND_LINK_WAIT_MS=600000

# friend-link-bot.mjs：git push 目标分支，默认取 GITHUB_REF_NAME（main）。
# FRIEND_LINK_TARGET_BRANCH=main

# gh-actions-logger.mjs：debug 级别日志开关（Actions 中亦可设 ACTIONS_STEP_DEBUG=true）。
# DEBUG=1
